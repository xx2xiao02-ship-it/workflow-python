{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "1256 AssetManifest",
  "type": "object",
  "required": ["timeline_unit", "duration_us", "assets", "director_segments", "warnings"],
  "properties": {
    "timeline_unit": {"type": "string", "const": "microseconds"},
    "duration_us": {"type": "integer", "minimum": 0},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "director_segments": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["asset_id", "kind", "uri", "start_us", "end_us", "duration_us", "source_node", "index", "metadata"],
      "properties": {
        "asset_id": {"type": "string"},
        "kind": {"enum": ["video", "audio", "caption"]},
        "uri": {"type": "string"},
        "start_us": {"type": "integer", "minimum": 0},
        "end_us": {"type": "integer", "minimum": 1},
        "duration_us": {"type": "integer", "minimum": 1},
        "source_node": {"type": "string"},
        "index": {"type": "integer", "minimum": 0},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
