{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "1256 Director Asset Storyboard",
  "type": "object",
  "required": ["directorial_strategy", "shots", "review"],
  "properties": {
    "directorial_strategy": {
      "type": "object",
      "required": ["story_question", "visual_spine", "reveal_policy", "continuity_bible"],
      "properties": {
        "story_question": {"type": "string", "minLength": 1},
        "visual_spine": {"type": "string", "minLength": 1},
        "reveal_policy": {"type": "string", "minLength": 1},
        "continuity_bible": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "group_id", "scene_id", "timeline", "narrative_job", "shot_size", "carrier", "composition", "camera_view", "action", "visual_anchor", "continuity_anchor", "reveal_stage", "asset_brief", "motion_brief", "asset_requirements", "avoid"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "group_id": {"type": "string", "pattern": "^g[0-9]+$"},
          "scene_id": {"type": "string", "minLength": 1},
          "timeline": {"type": "object", "required": ["start", "end", "duration_us"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "duration_us": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
          "narrative_job": {"type": "string", "minLength": 1},
          "shot_size": {"enum": ["超远景", "远景", "全景", "中景", "近景", "特写", "极特写"]},
          "carrier": {"enum": ["完整人物", "人物局部", "物件", "空间", "建筑环境"]},
          "composition": {"enum": ["纵向主体—物件关系", "边缘压力切入", "斜向纵深", "遮挡或框景", "局部焦点与留白"]},
          "camera_view": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "visual_anchor": {"type": "string", "minLength": 1},
          "continuity_anchor": {"type": "string", "minLength": 1},
          "reveal_stage": {"enum": ["开场", "展开", "转折", "收束"]},
          "asset_brief": {"type": "string", "minLength": 1},
          "motion_brief": {"type": "string", "minLength": 1},
          "asset_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "avoid": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "review": {"type": "object"}
  },
  "additionalProperties": false
}
