{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "1256 Director Convergence Input",
  "type": "object",
  "required": ["project_id", "run_id", "plan_version", "subplans", "visual_specs", "route_specs"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "plan_version": {"type": "string", "minLength": 1},
    "subplans": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "project_id", "run_id", "plan_version", "status", "source_nodes"],
        "properties": {
          "name": {"enum": ["narrative_intent", "timing_subtitles", "shot_breakdown", "visual_route"]},
          "project_id": {"type": "string", "minLength": 1},
          "run_id": {"type": "string", "minLength": 1},
          "plan_version": {"type": "string", "minLength": 1},
          "status": {"enum": ["READY", "OBSERVED_REDACTED"]},
          "source_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "visual_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shot_id", "group_id", "shot_index", "status", "fields", "observed_fields", "source_nodes"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "group_id": {"type": "string", "minLength": 1},
          "shot_index": {"type": "integer", "minimum": 0},
          "status": {"enum": ["READY", "OBSERVED_REDACTED"]},
          "fields": {"type": "object"},
          "observed_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "source_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "route_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shot_id", "group_id", "route_candidates", "selected_route", "status", "source_nodes"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "group_id": {"type": "string", "minLength": 1},
          "route_candidates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "selected_route": {"type": ["string", "null"]},
          "status": {"enum": ["CANDIDATES_ONLY", "SELECTED", "OBSERVED_REDACTED"]},
          "source_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
