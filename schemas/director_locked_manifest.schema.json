{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "1256 DirectorLockedManifest",
  "type": "object",
  "required": ["project_id", "run_id", "plan_version", "tts_fingerprint", "timeline_unit", "total_timeline", "groups", "shots", "captions", "requirements", "provenance", "status", "cinematic_story", "story_review_status", "story_revision", "narration_assets", "subtitle_pipeline"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "plan_version": {"type": "string", "minLength": 1},
    "tts_fingerprint": {"type": "string", "minLength": 1},
    "timeline_unit": {"const": "microseconds"},
    "total_timeline": {"$ref": "#/$defs/time_window"},
    "groups": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/group"}},
    "shots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shot"}},
    "captions": {"type": "array", "items": {"$ref": "#/$defs/caption"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "provenance": {"type": "array", "items": {"type": "object"}},
    "status": {"const": "DIRECTOR_LOCKED"},
    "cinematic_story": {"type": "object"},
    "story_review_status": {"const": "APPROVED"},
    "story_revision": {"type": "integer", "minimum": 1},
    "narration_assets": {"type": "array", "items": {"$ref": "#/$defs/narration_asset"}},
    "subtitle_pipeline": {"type": "object"},
    "digital_human_max_shot_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "sound_effect_plan": {"type": "array", "items": {"$ref": "#/$defs/sound_effect"}}
  },
  "additionalProperties": false,
  "$defs": {
    "time_window": {
      "type": "object",
      "required": ["start_us", "end_us", "duration_us"],
      "properties": {
        "start_us": {"type": "integer", "minimum": 0},
        "end_us": {"type": "integer", "minimum": 1},
        "duration_us": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false,
      "description": "duration_us must equal end_us - start_us"
    },
    "group": {
      "type": "object",
      "required": ["group_id", "group_index", "segment_text", "timeline", "shot_ids", "caption_ids", "narration_requirement_id", "metadata"],
      "properties": {
        "group_id": {"type": "string", "pattern": "^g[0-9]{2}$"},
        "group_index": {"type": "integer", "minimum": 0},
        "segment_text": {"type": "string", "minLength": 1},
        "timeline": {"$ref": "#/$defs/time_window"},
        "shot_ids": {"type": "array", "items": {"type": "string", "pattern": "^g[0-9]{2}_s[0-9]{2}$"}},
        "caption_ids": {"type": "array", "items": {"type": "string"}},
        "narration_requirement_id": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "required": ["shot_id", "group_id", "shot_index", "source_text", "clip_role", "story_beat", "timeline", "route_candidates", "requirement_ids", "production_spec"],
      "properties": {
        "shot_id": {"type": "string", "pattern": "^g[0-9]{2}_s[0-9]{2}$"},
        "group_id": {"type": "string", "pattern": "^g[0-9]{2}$"},
        "shot_index": {"type": "integer", "minimum": 0},
        "source_text": {"type": "string", "minLength": 1},
        "clip_role": {"type": "string", "minLength": 1},
        "story_beat": {"type": "string", "minLength": 1},
        "timeline": {"$ref": "#/$defs/time_window"},
        "route_candidates": {"type": "array", "items": {"type": "string"}},
        "requirement_ids": {"type": "array", "items": {"type": "string"}},
        "production_spec": {"type": "object"}
      },
      "additionalProperties": false
    },
    "caption": {
      "type": "object",
      "required": ["caption_id", "group_id", "text", "timeline", "source_node"],
      "properties": {
        "caption_id": {"type": "string", "minLength": 1},
        "group_id": {"type": "string", "pattern": "^g[0-9]{2}$"},
        "text": {"type": "string"},
        "timeline": {"$ref": "#/$defs/time_window"},
        "source_node": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "narration_asset": {
      "type": "object",
      "required": ["asset_id", "group_id", "timeline"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "group_id": {"type": "string", "pattern": "^g[0-9]{2}$"},
        "timeline": {"$ref": "#/$defs/time_window"}
      },
      "additionalProperties": true
    },
    "sound_effect": {
      "type": "object",
      "required": ["shot_id", "enabled", "subject", "subject_confidence", "sound_effect_id", "prompt", "cue_start_us", "cue_end_us", "volume", "status"],
      "properties": {
        "shot_id": {"type": "string", "pattern": "^g[0-9]{2}_s[0-9]{2}$"},
        "enabled": {"type": "boolean"}, "subject": {"type": "string"},
        "subject_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sound_effect_id": {"type": "string"}, "prompt": {"type": "string"},
        "cue_start_us": {"type": "integer", "minimum": 0}, "cue_end_us": {"type": "integer", "minimum": 1},
        "volume": {"type": "number", "minimum": 0, "maximum": 1}, "status": {"type": "string"}
      }, "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["requirement_id", "scope", "asset_type", "role", "group_id", "shot_ids", "mandatory", "route", "coverage_policy", "source_node", "timeline", "metadata"],
      "properties": {
        "requirement_id": {"type": "string", "minLength": 1},
        "scope": {"enum": ["shot", "group", "project"]},
        "asset_type": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "group_id": {"type": ["string", "null"]},
        "shot_ids": {"type": "array", "items": {"type": "string"}},
        "mandatory": {"type": "boolean"},
        "route": {"type": "string", "minLength": 1},
        "coverage_policy": {"type": "string", "minLength": 1},
        "source_node": {"type": "string", "minLength": 1},
        "timeline": {"anyOf": [{"$ref": "#/$defs/time_window"}, {"type": "null"}]},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
