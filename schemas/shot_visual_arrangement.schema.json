{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/1256/shot-visual-arrangement.schema.json",
  "title": "1256 全局视觉序列编排器节点契约",
  "description": "节点 116616；输入输出字段来自原始 YAML，运行装配顺序来自用户提供的原始 Coze Python 源码。时间线单位为微秒。",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "Code_list": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clip_duration": {"type": "array", "items": {"type": "number"}},
              "int_duration": {"type": "array", "items": {"type": "integer"}},
              "shots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "clip_duration": {"type": "number"},
                    "clip_role": {"type": "string"},
                    "source_text": {"type": "string"},
                    "story_beat": {"type": "string"}
                  },
                  "required": ["clip_duration", "clip_role", "source_text", "story_beat"],
                  "additionalProperties": true
                }
              },
              "timelines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "end": {"type": "integer"},
                    "start": {"type": "integer"}
                  },
                  "required": ["end", "start"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["clip_duration", "int_duration", "shots", "timelines"],
            "additionalProperties": true
          }
        },
        "ref_image": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "properties": {
                  "url": {"type": "string"},
                  "link": {"type": "string"},
                  "image_url": {"type": "string"},
                  "ref_image": {"type": "string"},
                  "ref": {"type": "string"}
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "segments": {"type": "array", "items": {"type": "string"}},
        "story_context": {"type": "object"},
        "debug": {"type": "boolean"},
        "character_anchor": {"type": "string"}
      },
      "required": ["Code_list", "segments"],
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "properties": {
        "prompt": {"type": "array", "items": {"type": "string"}},
        "ref_image": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref_image": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["ref_image"],
            "additionalProperties": false
          }
        },
        "motion_seed": {"type": "array", "items": {"type": "string"}},
        "timelines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {"type": "integer"},
              "end": {"type": "integer"}
            },
            "required": ["start", "end"],
            "additionalProperties": false
          }
        },
        "int_duration": {"type": "array", "items": {"type": "integer"}},
        "story_context": {"type": "array", "items": {"type": "object"}},
        "error": {"type": "string"},
        "debug": {
          "type": "object",
          "properties": {
            "assemble_ms": {"type": "number"},
            "build_ms": {"type": "number"},
            "gpt_group_count": {"type": "integer"},
            "gpt_input_chars": {"type": "integer"},
            "gpt_ms": {"type": "number"},
            "gpt_output_chars": {"type": "integer"},
            "gpt_shot_count": {"type": "integer"},
            "gpt_system_chars": {"type": "integer"},
            "mini_batches": {"type": "integer"},
            "mini_fallback_batches": {"type": "integer"},
            "mini_ms": {"type": "number"},
            "mini_parallel_workers": {"type": "integer"},
            "mini_success_batches": {"type": "integer"},
            "motion_seed_count": {"type": "integer"},
            "plan_validate_ms": {"type": "number"},
            "prompt_count": {"type": "integer"},
            "total_ms": {"type": "number"}
          },
          "additionalProperties": false
        }
      },
      "required": ["prompt", "ref_image", "motion_seed", "timelines", "int_duration", "error", "debug"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
