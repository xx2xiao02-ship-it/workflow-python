{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/1256/timeline-planning.schema.json",
  "title": "时长计算时间线规划 输入输出契约",
  "description": "Coze code node 127095. The runtime also accepts the JSON-string and single-item timeline compatibility forms implemented by the node.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "segments": { "type": "string" },
        "shots": {
          "type": "array",
          "items": { "$ref": "#/$defs/shotInput" }
        },
        "duration": { "type": "number" },
        "timelines": { "$ref": "#/$defs/timeline" }
      },
      "required": ["segments", "shots", "duration", "timelines"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "shots": {
          "type": "array",
          "items": { "$ref": "#/$defs/shotOutput" }
        },
        "clip_duration": {
          "type": "array",
          "items": { "type": "number" }
        },
        "int_duration": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "timelines": {
          "type": "array",
          "items": { "$ref": "#/$defs/timeline" }
        }
      },
      "required": ["shots", "clip_duration", "int_duration", "timelines"],
      "additionalProperties": false
    }
  },
  "$defs": {
    "shotInput": {
      "type": "object",
      "properties": {
        "source_text": { "type": "string" },
        "clip_role": { "type": "string" },
        "story_beat": { "type": "string" }
      },
      "required": ["source_text", "clip_role", "story_beat"],
      "additionalProperties": true
    },
    "shotOutput": {
      "type": "object",
      "properties": {
        "source_text": { "type": "string" },
        "clip_role": { "type": "string" },
        "story_beat": { "type": "string" },
        "clip_duration": { "type": "number" }
      },
      "required": ["source_text", "clip_role", "story_beat", "clip_duration"],
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "properties": {
        "start": { "type": "integer" },
        "end": { "type": "integer" }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
