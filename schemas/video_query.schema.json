{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/1256/video-query.schema.json",
  "title": "video_query 视频查询插件输入输出契约",
  "description": "Workflow node 106157. Network and TOS are intentionally not executed by local tests.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "task_id": {"type": "string"},
        "max_wait": {"type": "integer"},
        "check_interval": {"type": "integer"},
        "enable_tos_upload": {"type": "boolean"},
        "tos_path_prefix": {"type": "string"}
      },
      "required": ["task_id"],
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "properties": {
        "errorBody": {"type": ["object", "null"]},
        "file_size_mb": {"type": ["number", "null"]},
        "isSuccess": {"type": "boolean"},
        "msg": {"type": ["string", "null"]},
        "public_video_url": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "success": {"type": ["boolean", "null"]},
        "tip": {"type": ["string", "null"]}
      },
      "required": ["errorBody", "file_size_mb", "isSuccess", "msg", "public_video_url", "status", "success", "tip"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
